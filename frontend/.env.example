# API Gateway のベース URL
# 例: https://xxx.execute-api.ap-northeast-1.amazonaws.com
VITE_API_BASE_URL=

# Cognito User Pool の Hosted UI ドメイン
# 例: cooking-planner-dev.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Cognito App Client ID
VITE_COGNITO_CLIENT_ID=

# Cognito リージョン
# 例: ap-northeast-1
VITE_COGNITO_REGION=

# OAuth コールバック URL（Cognito App Client の設定と一致させること）
# 例（ローカル開発）: http://localhost:5173/callback
# 例（本番）        : https://xxx.cloudfront.net/callback
VITE_COGNITO_REDIRECT_URI=

# ログアウト後のリダイレクト URL（Cognito App Client の設定と一致させること）
# 例（ローカル開発）: http://localhost:5173
# 例（本番）        : https://xxx.cloudfront.net
VITE_COGNITO_LOGOUT_REDIRECT_URI=

# 開発用: 認証トークンを直接指定する場合（任意）
# 本番環境では使用しないこと
VITE_AUTH_TOKEN=
