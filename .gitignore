/node_modules
/.pnp
/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# エディタ / OS 依存ファイル
/.vscode/*
/.idea
.DS_Store

# フロントエンドのビルド成果物とローカル設定
/frontend/dist
/frontend/dist-ssr
/frontend/node_modules
/frontend/*.local
