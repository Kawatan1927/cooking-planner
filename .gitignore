# ルート直下の一時出力
/tmp
/out-tsc
/dist/
/logs/

# 依存ディレクトリとパッケージマネージャ生成物
/node_modules
/.pnp
/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# エディタ / OS 依存ファイル
/.vscode/*
/.idea
.DS_Store

# フロントエンドのビルド成果物とローカル設定
/frontend/dist
/frontend/dist-ssr
/frontend/node_modules
/frontend/*.local
/frontend/.env.production
/frontend/.env.local

# バックエンド（Hono サーバー）の依存
/backend/node_modules
/backend/.env

# Serena のローカル状態
/.serena/cache/
/.serena/project.local.yml
/.serena/memories/

# Docusaurus build artifacts
docs/.docusaurus
docs/build
docs/node_modules
docs/package-lock.json
backend/package-lock.json

# Cloudflare Tunnel local credentials and copied runtime config
/cloudflare/config.yml
/cloudflare/*.json
/cloudflare/cert.pem
/.cloudflared/
