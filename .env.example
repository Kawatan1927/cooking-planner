# Frontend
# bun run start では frontend をビルドして Hono と同一オリジンで配信するため /api を指定します。
# Vite dev server から backend を直接呼ぶローカル開発では frontend/.env.local で
# VITE_API_BASE_URL=http://localhost:3000/api を指定してください。
VITE_API_BASE_URL=/api

# Backend
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/cooking_planner
DEV_USER_ID=local-dev-user

# Optional: Cloudflare Tunnel / Access を代替案として使う場合のみ設定します。
# Tailscale Serve 構成では DEV_USER_ID=local-dev-user を固定します。
# CLOUDFLARE_ACCESS_TEAM_NAME=your-team-name
# CLOUDFLARE_ACCESS_AUD=your-application-aud
